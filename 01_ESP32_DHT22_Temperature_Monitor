
#include <WiFi.h>
#include "DHT.h"

// WiFi credentials
const char* ssid = "YOUR_WIFI_NAME";
const char* password = "YOUR_WIFI_PASSWORD";

// DHT22 configuration
#define DHTPIN 4
#define DHTTYPE DHT22

DHT dht(DHTPIN, DHTTYPE);

// LED pins
#define GREEN_LED 18
#define YELLOW_LED 19
#define RED_LED 21
#define BLUE_LED 22

void setup() {
  Serial.begin(115200);

  // Configure LEDs
  pinMode(GREEN_LED, OUTPUT);
  pinMode(YELLOW_LED, OUTPUT);
  pinMode(RED_LED, OUTPUT);
  pinMode(BLUE_LED, OUTPUT);

  // Turn off all LEDs
  digitalWrite(GREEN_LED, LOW);
  digitalWrite(YELLOW_LED, LOW);
  digitalWrite(RED_LED, LOW);
  digitalWrite(BLUE_LED, LOW);

  // Start DHT sensor
  dht.begin();

  // Connect to WiFi
  Serial.println("Connecting to WiFi...");

  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi Connected!");
  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());

  // Blue LED indicates WiFi connection
  digitalWrite(BLUE_LED, HIGH);
}

void loop() {

  // Read temperature and humidity
  float temperature = dht.readTemperature();
  float humidity = dht.readHumidity();

  // Check sensor readings
  if (isnan(temperature) || isnan(humidity)) {
    Serial.println("DHT22 Sensor Error!");
    delay(2000);
    return;
  }

  // Display readings
  Serial.println("----------------------");
  Serial.print("Temperature: ");
  Serial.print(temperature);
  Serial.println(" °C");

  Serial.print("Humidity: ");
  Serial.print(humidity);
  Serial.println(" %");

  // Turn off temperature LEDs
  digitalWrite(GREEN_LED, LOW);
  digitalWrite(YELLOW_LED, LOW);
  digitalWrite(RED_LED, LOW);

  // Temperature-based LED control
  if (temperature < 25) {

    digitalWrite(GREEN_LED, HIGH);
    Serial.println("Status: MINIMUM TEMPERATURE");

  }
  else if (temperature <= 35) {

    digitalWrite(YELLOW_LED, HIGH);
    Serial.println("Status: MODERATE TEMPERATURE");

  }
  else {

    digitalWrite(RED_LED, HIGH);
    Serial.println("Status: EXTREME TEMPERATURE");

  }

  // Maintain WiFi status LED
  digitalWrite(BLUE_LED,
               WiFi.status() == WL_CONNECTED ? HIGH : LOW);

  delay(2000);
}

